# 내부 PostgreSQL (2026-06-16 Supabase에서 이관)
DATABASE_URL=postgresql://user:password@127.0.0.1:5438/ainews

# 관리자 인증
ADMIN_PASSWORD=change-me
ADMIN_SECRET=32자-이상의-랜덤-문자열

# 수집 파이프라인(n8n) 전용 쓰기 API 토큰 — 32자 이상 필수
# 미설정 시 /api/news/upsert, /api/news/check-exists 는 503으로 거부된다 (fail-closed)
INGEST_TOKEN=32자-이상의-랜덤-문자열
# (같은 토큰으로 POST /api/internal/briefing/generate 도 보호한다)

# 데일리 브리핑 생성용 LiteLLM (OpenAI 호환 프록시)
LITELLM_BASE_URL=http://127.0.0.1:4100
LITELLM_API_KEY=sk-your-litellm-key
# 선택: 모델(기본 anthropic-api-haiku-5-5), 1회 실행 비용 상한 USD(기본 0.10)
# BRIEFING_MODEL=anthropic-api-haiku-5-5
# BRIEFING_MAX_COST_USD=0.10
